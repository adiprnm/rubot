<div class="msg user">
  <div class="bubble"><span class="sr-only">Kamu: </span><%= h(text) %></div>
</div>

<div class="turn"
     hx-ext="sse"
     sse-connect="/turns/<%= h(turn.id) %>/stream<%= h(token_query) %>"
     sse-close="done"
     aria-live="polite"
     x-init="$store.turn.active = '<%= turn.id %>'">
  <div class="turn-body" sse-swap="turn"><%= timeline(turn) %></div>
  <%# A confirmation that was already waiting when the page was refreshed is
      drawn here: its event has long been in the log the stream no longer
      replays, so leaving the slot empty would strand a turn behind a question
      nobody can see. -%>
  <div class="confirm" sse-swap="confirm"><%= View.render("_confirm", prompt: turn.confirm_prompt, turn_id: turn.id) %></div>
  <div class="notice" sse-swap="notice"></div>
  <%# Where the status row's out-of-band swap arrives. The payload carries
      hx-swap-oob, so htmx applies it to #usage and this slot stays empty. -%>
  <div class="status-slot" sse-swap="usage" hidden></div>
  <%# Same for the sidebar and the header: the conversation gains its name when
      this turn is written to disk. -%>
  <div class="sidebar-slot" sse-swap="sidebar" hidden></div>
  <%# The working row is not part of the timeline: it is drawn in the band
      above the composer, so this fragment carries it out of band. Its own
      `working` event keeps that band current while a tool call resets the
      clock. -%>
  <div class="working-slot" sse-swap="working" hidden></div>
  <%= View.render("_working", since: turn.epoch) %>
</div>
