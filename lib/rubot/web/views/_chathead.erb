<%# Which persona, and which of its conversations. The persona alone is not
    enough once one persona owns several sessions: every tab would look the
    same. The session name is the prompt that opened the conversation.

    `data-title` carries the same name in the form the browser tab wants, so
    the page can adopt it without re-deriving it. -%>
<header class="chat-head" id="chat-head" data-title="<%= h(document_title) %>">
  <%# The drawer's handle. It lives here rather than beside the drawer so that
      it is reachable from the one screen a phone has, and it is re-rendered
      with the header after a turn so the two never disagree about state. -%>
  <button class="nav-toggle" type="button" aria-label="Persona dan sesi"
          :aria-expanded="nav ? 'true' : 'false'" @click="nav = !nav">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M2.5 4h11M2.5 8h11M2.5 12h11" />
    </svg>
    <%# What is behind the handle. On a phone the roster is a drawer away, so
        without this the other personas' news would only be found by opening
        it. -%>
    <%= View.render("_nav_badge", total: unread_total) %>
  </button>
  <span class="emoji" aria-hidden="true"><%= h(persona_emoji) %></span>
  <b><%= h(persona_label) %></b>
  <% if session_label -%>
    <span class="sep" aria-hidden="true">·</span>
    <%# The name is the reader's to change: the automatic one is a guess from the
        first prompt, and a conversation someone returns to deserves the name
        they remember it by. Tapping the name turns it into a field; Enter saves,
        Escape leaves it as it was. The answer swaps the header and the sidebar
        in place, so the tab and the list follow without a reload. -%>
    <span class="session-rename" x-data="{ editing: false }" @keydown.escape="editing = false">
      <button class="session-name" type="button" title="Ubah nama sesi"
              aria-label="Ubah nama sesi: <%= h(session_label) %>"
              x-show="!editing"
              @click="editing = true; $nextTick(() => $refs.field.select())"><%= h(session_label) %></button>
      <form class="session-rename-form" x-show="editing" x-cloak
            method="post"
            action="/s/<%= h(session_id) %>/rename<%= h(token_query) %>"
            hx-post="/s/<%= h(session_id) %>/rename<%= h(token_query) %>"
            hx-target="#chat-head"
            hx-swap="outerHTML">
        <input class="session-rename-field" name="name" x-ref="field" required
               value="<%= h(session_label) %>"
               maxlength="<%= Rubot::SessionNamer::MAX_TITLE_CHARS %>"
               autocomplete="off" aria-label="Nama sesi" enterkeyhint="done">
        <button type="submit" title="Simpan nama" aria-label="Simpan nama">✓</button>
        <button type="button" title="Batal" aria-label="Batal"
                @click="editing = false">×</button>
      </form>
    </span>
  <% end -%>
  <a class="chat-settings-link" href="/settings<%= h(token_query) %>" aria-label="pengaturan" title="pengaturan">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
      <path d="M13.3 9.4a1.1 1.1 0 0 0 .22 1.22l.04.04a1.34 1.34 0 1 1-1.9 1.9l-.04-.04a1.1 1.1 0 0 0-1.22-.22 1.1 1.1 0 0 0-.67 1.01V13.5a1.34 1.34 0 0 1-2.68 0v-.07a1.1 1.1 0 0 0-.72-1.01 1.1 1.1 0 0 0-1.22.22l-.04.04a1.34 1.34 0 1 1-1.9-1.9l.04-.04a1.1 1.1 0 0 0 .22-1.22 1.1 1.1 0 0 0-1.01-.67H2.5a1.34 1.34 0 0 1 0-2.68h.07a1.1 1.1 0 0 0 1.01-.72 1.1 1.1 0 0 0-.22-1.22l-.04-.04a1.34 1.34 0 1 1 1.9-1.9l.04.04a1.1 1.1 0 0 0 1.22.22h.05a1.1 1.1 0 0 0 .67-1.01V2.5a1.34 1.34 0 0 1 2.68 0v.07a1.1 1.1 0 0 0 .67 1.01 1.1 1.1 0 0 0 1.22-.22l.04-.04a1.34 1.34 0 1 1 1.9 1.9l-.04.04a1.1 1.1 0 0 0-.22 1.22v.05a1.1 1.1 0 0 0 1.01.67H13.5a1.34 1.34 0 0 1 0 2.68h-.07a1.1 1.1 0 0 0-1.01.67z" />
    </svg>
  </a>
</header>
