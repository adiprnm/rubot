<%# The sidebar's two lists. Pinned is what the reader chose to keep, ordered by
    when each was pinned; Recent is everything else, newest first, twenty rows
    to a block with a control at the end that loads the next block. Both are
    <details open>, so they can be folded away on a phone but are both visible
    on a first visit — a section that starts closed would hide conversations the
    reader never asked to hide.

    The whole nav is swapped as one piece: after a turn names a conversation, or
    after a pin moves one, both sections can change at once. -%>
<nav class="sessions" id="sessions">
  <details class="session-group" open>
    <summary class="group-head" title="<%= h(I18n.t("web.sessions.pin_limit")) %>">
      <span class="group-name"><%= h(I18n.t("web.sessions.pinned")) %></span>
      <span class="group-count"><%= groups[:pinned].size %>/<%= groups[:pinned_limit] %></span>
    </summary>
    <% if groups[:pinned].empty? %>
      <p class="group-empty"><%= h(I18n.t("web.sessions.empty_pinned")) %></p>
    <% else %>
      <% groups[:pinned].each do |row| %>
        <%= View.render("_session_row", row: row, token_query: token_query,
                                       page: groups[:page], current: groups[:current]) %>
      <% end %>
    <% end %>
  </details>

  <details class="session-group" open>
    <summary class="group-head">
      <span class="group-name"><%= h(I18n.t("web.sessions.recent")) %></span>
      <span class="group-count"><%= groups[:recent_total] %></span>
    </summary>
    <% if groups[:recent].empty? %>
      <p class="group-empty"><%= h(I18n.t("web.sessions.empty_recent")) %></p>
    <% else %>
      <% groups[:recent].each do |row| %>
        <%= View.render("_session_row", row: row, token_query: token_query,
                                       page: groups[:page], current: groups[:current]) %>
      <% end %>
    <% end %>

    <%# "Load more" continues the list instead of paging through it: the answer
        is appended where the button was, and the button follows it. A page
        swap would throw away the rows the reader was just looking at. -%>
    <% if groups[:more] %>
      <%= View.render("_recent_more", current: groups[:current],
                                     page: groups[:next_page],
                                     token_query: token_query) %>
    <% end %>
  </details>
</nav>
