<%# The two left columns are one dock, not two siblings: on a phone there is no
    room for either of them, so both slide away together and come back
    together as a single drawer behind the button in the chat header. -%>
<div class="app" x-data="{ nav: false }" :class="{ 'nav-open': nav }"
     @keydown.escape.window="nav = false"
     @rubot:search.window="nav = false"
     @rubot:nav.window="nav = $event.detail.open">
<div class="side-dock">
  <%# The leftmost column is a roster, not a menu: one round avatar per
      persona, named on hover, the way a chat app lists the places you can be.
      It stays narrow because a persona is a face, not a row of text. -%>
  <nav class="rail" aria-label="Persona">
    <a class="rail-brand" href="/<%= h(token_query) %>" title="rubot" aria-label="rubot">r</a>

    <ul class="rail-list">
      <% personas.each do |row| %>
        <li>
          <a class="rail-item<%= row[:active] ? " is-active" : "" %>"
             href="/p/<%= h(row[:slug]) %><%= h(token_query) %>"
             title="<%= h(row[:label]) %>"
             aria-label="<%= h(row[:label]) %>"
             <%= row[:active] ? 'aria-current="page"' : "" %>>
            <span class="avatar" aria-hidden="true"><%= h(row[:emoji]) %></span>
          </a>
        </li>
      <% end %>
    </ul>

    <%# The form opens as a dialog in the middle of the screen rather than
        inside the rail: a persona needs a slug, a name and a prompt, and none
        of those fit in five rems. -%>
    <details class="rail-new">
      <summary title="Persona baru" aria-label="Persona baru">
        <span class="avatar" aria-hidden="true">+</span>
      </summary>
      <form class="rail-panel" hx-post="/personas<%= h(token_query) %>" hx-target=".form-error" hx-swap="innerHTML">
        <p class="panel-title">Persona baru</p>
        <label>Slug
          <input name="slug" placeholder="kanyaah" pattern="[a-z0-9][a-z0-9_-]{0,31}" required>
        </label>
        <label>Nama
          <input name="name" placeholder="Kanyaah">
        </label>
        <label>Emoji
          <select name="emoji">
            <% %w[🤖 🧭 ✍️ 📚 🧪 🎨 🛠️ 🔍 🧠 💼].each do |choice| %>
              <option value="<%= h(choice) %>"><%= h(choice) %></option>
            <% end %>
          </select>
        </label>
        <label>System prompt
          <textarea name="system_prompt" rows="3" placeholder="Kamu spesialis …"></textarea>
        </label>
        <button class="btn primary" type="submit">Buat</button>
        <p class="form-error"></p>
      </form>
    </details>
  </nav>

  <aside class="sidebar">
    <header class="side-head">
      <span class="emoji" aria-hidden="true"><%= h(persona_emoji) %></span>
      <b><%= h(persona_label) %></b>

      <%# The persona is editable where it is named, not in a settings page of
          its own: name, face and the prompt it speaks with are the whole of
          what a persona is from this side. The slug stays out — it is the key
          and the workspace directory's name. -%>
      <details class="side-edit">
        <summary title="Edit persona" aria-label="Edit persona">✎</summary>
        <form class="rail-panel" hx-post="/p/<%= h(slug) %>/edit<%= h(token_query) %>"
              hx-target=".edit-error" hx-swap="innerHTML">
          <p class="panel-title">Edit persona</p>
          <p class="panel-hint">slug: <code><%= h(slug) %></code></p>
          <label>Nama
            <input name="name" value="<%= h(persona_label) %>" placeholder="<%= h(slug) %>">
          </label>
          <label>Emoji
            <select name="emoji">
              <% (%w[🤖 🧭 ✍️ 📚 🧪 🎨 🛠️ 🔍 🧠 💼] | [ persona_emoji ]).each do |choice| %>
                <option value="<%= h(choice) %>"<%= " selected" if choice == persona_emoji %>><%= h(choice) %></option>
              <% end %>
            </select>
          </label>
          <label>System prompt
            <textarea name="system_prompt" rows="6"
                      placeholder="Kosongkan untuk memakai prompt bawaan"><%= h(persona_prompt) %></textarea>
          </label>
          <input type="hidden" name="session_id" value="<%= h(session_id) %>">
          <button class="btn primary" type="submit">Simpan</button>
          <p class="form-error edit-error"></p>
        </form>
      </details>
    </header>

        <%# The way into the archive: every message ever stored, including the turns
        a compacted session no longer shows the model — which is the reason the
        archive exists at all. It sits beside "+ Sesi baru" because both are
        about this persona's conversations, and one of them makes a new one.

        The dialog itself is at the end of the page: it is not part of the
        sidebar's flow, and the top layer it opens into is not either. -%>
    <div class="side-actions">
      <form class="new-session" method="post" action="/p/<%= h(slug) %>/sessions<%= h(token_query) %>">
        <button class="btn primary" type="submit"><span aria-hidden="true">+</span> Sesi baru</button>
      </form>
      <button class="search-open" type="button" data-search-open
              aria-label="Cari percakapan" title="Cari percakapan (⌘K)"><%= search_icon %></button>
    </div>

    <%# Two lists, not one: what the reader chose to keep, and the rest of the
        archive a page at a time. Each is its own folded section so a long
        archive does not push the pinned ones out of reach. -%>
    <%= View.render("_sessions", groups: groups, token_query: token_query) %>

    <%# Nothing is being asked while the page sits idle, so the news that a job
        fired and opened a conversation arrives on a stream of its own. What it
        carries is the sidebar, marked out of band, which is how a row can
        appear without the page being asked again. The swap sits in a child:
        the extension only finds a source in the parentage, never on itself. -%>
    <div class="session-events" hidden
         hx-ext="sse"
         sse-connect="/events?sid=<%= h(session_id) %><%= h(token_query.sub("?", "&")) %>">
      <span sse-swap="sidebar"></span>
    </div>

    <div class="sidebar-foot">
      <dl>
        <dt>persona</dt>
        <dd><%= h(slug) %></dd>
        <dt>model</dt>
        <dd><%= h(persona_model) %></dd>
        <dt>sesi</dt>
        <dd title="<%= h(session_id) %>"><%= h(session_short) %></dd>
      </dl>

      <%# Three palettes, one press each. The choice is the reader's and lives
          on their device, so it is stored where a device keeps things and
          nowhere near the session: two people reading the same conversation
          should each get their own colours. -%>
      <%= View.render("_theme_picker") %>
    </div>
  </aside>
</div>

<%# Tapping beside the drawer closes it, the way a sheet does. Hidden on wide
    screens, where the dock is part of the page and there is nothing to close.
    It is drawn from the `.nav-open` class (see app.css) so that it can fade out
    after the drawer rather than vanish under it. -%>
<div class="nav-scrim" @click="nav = false" aria-hidden="true"></div>

  <main class="chat">
    <%= View.render("_chathead",
                    persona_emoji: persona_emoji,
                    persona_label: persona_label,
                    session_label: session_label,
                    document_title: document_title) %>

    <div id="thread" class="thread">
      <%# Only the tail of the conversation is drawn. The rest is one page of
          entries away, fetched when the reader scrolls up to the marker — a
          session with hundreds of turns should not cost a full render, and the
          bottom of it is all anyone opens it for. -%>
      <%= View.render("_history", entries: page[:entries], more: page[:more],
                                  older_url: older_url, landed: page[:landed]) %>
      <% if page[:entries].empty? && live_turn.nil? %>
        <p class="empty">
          <%= h(persona_label) %> punya SOUL, skills, dan memory sendiri.
          Apa pun yang dijalankannya lewat tool tampil di atas jawabannya.
          Sesi baru mulai dari percakapan kosong, dengan persona yang sama.
        </p>
      <% end %>
      <%# A turn still in flight is drawn after the history and opens its own
          stream again: the prompt it is answering is not in the session file
          yet, so this fragment is the only record of it on a refreshed page. -%>
      <% if live_turn %>
        <%= View.render("_turn", turn: live_turn, text: live_turn.prompt,
                        token_query: token_query) %>
      <% end %>
    </div>

    <%# The band the working row lands in. It sits between the thread and the
        field on purpose: "still working" is a state of the page, not an entry
        in the conversation, and the composer is where the eye already is when
        a turn is slow. Kept in the DOM while empty so the thread does not
        change height the moment a turn starts.

        A page that opens on a turn already in flight draws the row here, in
        the one element that owns it. The stream never touches this band again:
        the row is drawn once and the clock inside it counts on its own. -%>
    <% if live_turn %>
      <%= View.render("_working", since: live_turn.epoch) %>
    <% else %>
      <div id="working" class="working-band"></div>
    <% end %>

    <%# Where a refused prompt is repeated. The composer keeps its text when the
        server says no, so the reason has to sit beside the field that held it. -%>
    <div id="composer-notice" class="composer-notice" hidden></div>

    <%= View.render("_composer", session_id: session_id, token_query: token_query) %>

    <%# The footer is facts about the conversation, not about the moment: that
        a turn is running is said in the band above the field, where the work
        is, and never here.

        The button at the end of it opens the same report written out, plus the
        provider's allowance — the two questions a glance at three figures
        actually raises. -%>
    <div class="status-line">
      <%= View.render("_usage", **usage) %>
      <%= View.render("_usage_sheet", session_id: session_id, token_query: token_query,
                                      facts: usage_facts) %>
    </div>
  </main>
</div>

<%# The archive, in a dialog of its own. It lives outside the app grid because a
    modal is hoisted to the top layer anyway, and escaping the grid keeps the
    two from ever arguing about width. -%>
<%= View.render("_search_dialog", token_query: token_query) %>

<%# The sheet a picture opens into. One of them serves every image on the page:
    the click handler fills in its src from the picture that was pressed, so a
    thread with a hundred screenshots still costs one sheet. `hidden` keeps it
    out of the page — and out of the tab order — until something opens it. -%>
<div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Pratinjau gambar">
  <figure class="lightbox-figure">
    <img class="lightbox-image" alt="">
    <figcaption class="lightbox-actions">
      <a class="btn lightbox-download" href="#" download>Unduh</a>
      <button type="button" class="btn lightbox-close" aria-label="Tutup pratinjau">Tutup</button>
    </figcaption>
  </figure>
</div>
