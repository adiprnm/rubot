<%# Only the prompt is quoted in a bubble. The answer is the page speaking, so
    it takes the full column with nothing around it. -%>
<% if role == "user" -%>
<div class="msg user">
  <div class="bubble"><span class="sr-only">Kamu: </span><%= h(text) %></div>
</div>
<% else -%>
<div class="text"><span class="sr-only">Rubot: </span><%= fmt(text) %></div>
<% end -%>
