<%# One row per delegated run: the persona it runs as, what it last did, and how
    it ended. The same rows the strip above the composer draws, kept here so
    they can still be read after the turn that asked for them is over. -%>
<% if subagents.empty? -%>
  <p class="usage-note">Belum ada subagent di percakapan ini.</p>
<% else -%>
  <ul class="subagent-rows">
<% subagents.each do |s| -%>
    <li class="subagent subagent-<%= h(s[:phase]) %>">
      <span class="subagent-mark" aria-hidden="true"><%= s[:phase] == "done" ? "✓" : (s[:phase] == "failed" ? "✗" : "⟡") %></span>
      <span class="subagent-name"><%= h(s[:agent]) %></span>
      <span class="subagent-detail"><%= h(s[:line] || s[:detail]) %></span>
    </li>
<% end -%>
  </ul>
<% end -%>
