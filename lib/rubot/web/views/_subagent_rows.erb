<%# The delegated runs of one conversation, newest first, as the footer's sheet
    draws them. One row per run, and the row itself — the line, the brief behind
    it, and the id it opens under — is `_subagent_row`, which the transcript
    draws too.

    The id is the run's and not the position's: this list is replaced whole on
    every step a run takes, so a row keeps its state while the ones above it
    change (see app.js, restoreSubagentBriefs). -%>
<% if subagents.empty? -%>
  <p class="usage-note"><%= h(I18n.t("web.subagents.empty")) %></p>
<% else -%>
  <ul class="subagent-rows">
<% subagents.each do |s| -%>
<%   run_id = s[:run_id].to_s -%>
<%   attrs = run_id.empty? ? "" : %( id="subagent-run-#{h(run_id)}") -%>
    <li class="subagent subagent-<%= h(s[:phase]) %>">
      <%= View.render("_subagent_row",
                      run: { agent: s[:agent], phase: s[:phase], line: s[:line],
                             task: s[:task], result: s[:result], error: s[:error] },
                      wrapper_class: "subagent-more", attrs: attrs) %>
    </li>
<% end -%>
  </ul>
<% end -%>
