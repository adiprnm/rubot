<%# One row per delegated run: the persona it runs as, what it was asked to do,
    how far it has got, and how it ended. The same rows the strip above the
    composer draws, kept here so they can still be read after the turn that
    asked for them is over.

    `line` is the whole sentence and the only thing drawn: a row is never
    half-assembled here, so the sheet and the transcript cannot disagree about
    a run (see Web::SubagentLine). The task rides on the row as a tooltip too,
    where a long one is still readable after the line has been cut. -%>
<% if subagents.empty? -%>
  <p class="usage-note"><%= h(I18n.t("web.subagents.empty")) %></p>
<% else -%>
  <ul class="subagent-rows">
<% subagents.each do |s| -%>
    <li class="subagent subagent-<%= h(s[:phase]) %>"<% if s[:task].to_s != "" %> title="<%= h(s[:task]) %>"<% end %>>
      <span class="subagent-mark" aria-hidden="true"><%= s[:phase] == "done" ? "✓" : (s[:phase] == "failed" ? "✗" : "⟡") %></span>
      <span class="subagent-name"><%= h(s[:agent]) %></span>
      <span class="subagent-detail"><%= h(s[:line]) %></span>
    </li>
<% end -%>
  </ul>
<% end -%>
