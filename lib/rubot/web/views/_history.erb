<%# One page of a conversation, oldest first. The marker sits above the entries
    it precedes, so a reader who scrolls to the top is handed the page before
    this one in the same place — the swap replaces the marker with the older
    page and a marker of its own, and the order of the thread never changes.

    It is a reveal rather than a scroll listener: htmx asks for the page when
    the marker actually enters the viewport, which is exactly when the reader
    has reached the top, and stops asking when there is nothing older left. -%>
<% if more -%>
<div class="history-more" hx-get="<%= h(older_url) %>" hx-trigger="revealed" hx-swap="outerHTML">
  <span>Pesan sebelumnya…</span>
</div>
<% end -%>
<% entries.each do |msg| -%>
<%# The entry a search result landed on. The hit names a message; a turn wraps
    several of them, so the entry is what gets marked — and the mark is what
    the browser scrolls to, since an id can only name a message. -%>
<% landed_here = !landed.nil? && msg.equal?(landed) -%>
<% if msg[:kind] == :prompt -%>
<%= View.render("_message", role: "user", text: msg[:text], anchor: "m-#{msg[:idx]}",
                            landed: landed_here) %>
<% else -%>
<div class="turn is-done<%= " is-landed" if landed_here %>"<% if msg[:idx] %> id="m-<%= msg[:idx] %>"<% end %>>
  <div class="turn-body"><%= View.render("_timeline", items: msg[:items],
                                          token_query: token_query,
                                          ig_accounts: ig_accounts,
                                          ig_linkable_accounts: ig_linkable_accounts,
                                          ig_persona: ig_persona) %></div>
</div>
<% end -%>
<% end -%>
