<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <%# The theme is chosen before the first paint. Left to the stylesheet, the
      page would arrive in the default palette and then swap, which on a light
      theme is a flash of dark across the whole screen. This runs in the head,
      from the same key the picker in the drawer writes to, so the first frame
      is already in the right colours.

      Until the script has run, `data-theme` is unset and the stylesheet's
      default — Everforest — applies; `color-scheme` is set here rather than in
      the CSS so the browser's own scrollbars and form controls follow the
      choice on the very first frame too. -%>
  <script>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem("rubot-theme"); } catch (_e) { /* private mode */ }
      var theme = saved === "light" || saved === "dark" || saved === "everforest"
        ? saved
        : (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light" : "everforest");
      document.documentElement.setAttribute("data-theme", theme);
      document.documentElement.style.colorScheme = theme === "light" ? "light" : "dark";
    })();
  </script>
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#2b332f">
  <%# Installable as an app: the manifest says what to call it and how to open
      it, and the two Apple metas are what iOS reads instead of the manifest. -%>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/assets/icon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="rubot">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>rubot · <%= h(title) %></title>
  <link rel="preload" href="/assets/source-serif-4-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/martian-mono-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/app.css?v=<%= h(asset_version) %>">
  <script src="/vendor/htmx.min.js"></script>
  <script src="/vendor/htmx-sse.js"></script>
  <script src="/assets/app.js?v=<%= h(asset_version) %>"></script>
  <script src="/vendor/alpine.min.js" defer></script>
</head>
<body>
<%= content %>
</body>
</html>
