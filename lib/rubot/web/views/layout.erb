<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <%# The theme and the reading face are chosen before the first paint: see the
      partial, which the gate and the settings page use too. -%>
  <%= View.render("_appearance_head") %>
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#2b332f">
  <%# Installable as an app: the manifest says what to call it and how to open
      it, and the two Apple metas are what iOS reads instead of the manifest. -%>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/assets/icon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="rubot">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>rubot · <%= h(title) %></title>
  <link rel="preload" href="/assets/source-serif-4-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/martian-mono-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/app.css?v=<%= h(asset_version) %>">
  <script src="/vendor/htmx.min.js"></script>
  <script src="/vendor/htmx-sse.js"></script>
  <script src="/assets/app.js?v=<%= h(asset_version) %>"></script>
  <script src="/vendor/alpine.min.js" defer></script>
</head>
<body>
<%= content %>
</body>
</html>
