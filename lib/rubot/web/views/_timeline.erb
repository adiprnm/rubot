<%# The turn's timeline, in the order it happened: what the model thought,
    what it said before reaching for a tool, the tool row, the answer.

    A live turn draws every row with an id (see View#item_attrs), and the
    stream then sends only the rows that changed: a row added at the end, a row
    whose content moved, a row that left. The whole timeline is only re-sent
    when the page has to be resynced — at the close of the turn. A transcript
    read back from disk passes no `item_prefix` and gets no ids at all. -%>
<% items.each do |item| -%>
<% case item[:kind] -%>
<% when :thinking -%>
<% if item[:closed_at] -%>
<p class="row thinking done"<%= item_attrs(item) %>><span class="label">Thought for <%= dur(item[:elapsed]) %></span></p>
<% else -%>
<p class="row thinking" data-since="<%= item[:epoch] %>" data-threshold="<%= Turn::THINKING_SECONDS %>"<%= item_attrs(item) %>><span class="label glow"<%= glow_step("Thinking…") %> aria-label="Thinking…"><%= glow("Thinking…") %></span><span class="live-clock"></span></p>
<% end -%>
<% when :tool -%>
<% slow = item[:elapsed] && item[:elapsed] >= Turn::SLOW_TOOL_SECONDS -%>
<% live = item[:state] == :running -%>
<%# The light is the newest call's, open or just finished (see Turn#mark_awake_call):
    one row, until the turn closes. A call is a sentence, not a glyph with a
    sentence beside it — the row has no mark — and while the sentence is lit it
    keeps an aria-label, because the letters are split one per span and a screen
    reader would otherwise read them out as a list. -%>
<% lit = live || item[:awake] -%>
<div class="tool-row <%= item[:state] %><%= " is-swapped" if item[:swap_ms] %>" data-tool-key="<%= h("#{item[:name]}·#{item[:detail]}") %>"<% if item[:swap_ms] %> style="animation-delay: -<%= item[:swap_ms] %>ms"<% end %><% if live %> data-since="<%= item[:epoch] %>" data-threshold="<%= Turn::SLOW_TOOL_SECONDS %>"<% end %><%= item_attrs(item) %>>
  <span class="tool-detail<%= " glow" if lit %>"<%= glow_step(item[:detail]) if lit %><% if lit %> aria-label="<%= h(item[:detail]) %>"<% end %><% if item[:title].to_s != "" %> title="<%= h(item[:title]) %>"<% end %>><%= lit ? glow(item[:detail]) : h(item[:detail]) %></span>
  <span class="live-clock"><%= slow ? dur(item[:elapsed]) : "" %></span>
</div>
<% when :steer -%>
<%= View.render("_message", role: "user", text: item[:text]) %>
<% when :attachments -%>
<%= View.render("_attachments", attachments: item[:list], attrs: item_attrs(item)) %>
<% when :instagram_connect -%>
<%= View.render("_instagram_connect", token_query: token_query, ig_accounts: ig_accounts,
                                      ig_linkable_accounts: ig_linkable_accounts, ig_persona: ig_persona) %>
<% when :text -%>
<div class="text<%= item[:live] ? " is-live" : "" %>"<%= item_attrs(item) %>><%= fmt(item[:text]) %></div>
<% when :diff -%>
<%= item[:html] %>
<% when :compaction -%>
<div class="compaction-row<%= " is-running" if item[:state] == :running %><%= " is-done" unless item[:state] %>" role="status" title="Ringkasan otomatis: percakapan lama diringkas untuk mengosongkan konteks"<%= item_attrs(item) %>>
<% if item[:state] == :running -%>
  <span class="compaction-label glow"<%= glow_step("Compaction sedang berlangsung…") %> aria-label="Compaction sedang berlangsung"><%= glow("Compaction sedang berlangsung…") %></span>
<% elsif item[:state] == :failed -%>
  <span class="compaction-label">Ringkasan tidak berhasil dibuat</span>
<% else -%>
  <span class="compaction-label">Konteks diringkas.</span>
  <span class="compaction-detail"><%= item[:before] %> → <%= item[:after] %> token<% if item[:elapsed].to_f.positive? %> · <%= dur(item[:elapsed]) %><% end %></span>
<% end -%>
</div>
<% when :subagent -%>
<div class="subagent-row subagent-<%= h(item[:phase]) %>"<% if item[:task] && !item[:task].empty? %> title="<%= h(item[:task]) %>"<% end %><%= item_attrs(item) %>>
  <span class="subagent-mark" aria-hidden="true"><%= item[:phase] == "done" ? "✓" : (item[:phase] == "failed" ? "✗" : "⟡") %></span>
  <span class="subagent-name"><%= h(item[:agent]) %></span>
  <span class="subagent-detail"><%= h(item[:detail]) %></span>
</div>
<% end -%>
<% end -%>
