<%# What the three figures in the status row are made of. The row is a glance —
    a cost, a cache share, a slice of the context window — and this is the same
    report written out: how many requests paid for that cost, how the tokens
    split, which model answered.

    It is redrawn by the same out-of-band swap the row is (see
    `usage_markup_with`), so a reader who leaves the panel open while a turn
    runs watches these numbers move too. `id` is what the swap lands on, which
    is why the list has one and the panel around it does not. -%>
<dl class="usage-facts" id="usage-facts">
  <dt><%= h(I18n.t("web.usage.facts.model")) %></dt>
  <dd title="<%= h(model) %>"><%= h(model) %></dd>

  <dt><%= h(I18n.t("web.usage.facts.cost")) %></dt>
  <dd class="usage-cost">
    <span class="value"><%= h(cost) %></span>
    <% unless breakdown.to_s.empty? -%>
      <span class="usage-breakdown" title="<%= h(breakdown) %>"><%= h(breakdown) %></span>
    <% end -%>
  </dd>

  <dt><%= h(I18n.t("web.usage.facts.requests")) %></dt>
  <dd><%= h(requests) %> · <%= h(I18n.t("web.usage.facts.messages", count: messages)) %></dd>

  <dt><%= h(I18n.t("web.usage.facts.tokens")) %></dt>
  <dd><%= h(I18n.t("web.usage.facts.split", input: tokens_in, output: tokens_out)) %><% if reasoning.to_s.empty? == false %> · <%= h(I18n.t("web.usage.facts.reasoning", tokens: reasoning)) %><% end %></dd>

  <% unless re_read.to_s.empty? -%>
    <dt><%= h(I18n.t("web.usage.facts.reread")) %></dt>
    <dd title="<%= h(I18n.t("web.usage.facts.reread_title")) %>"><%= h(I18n.t("web.usage.facts.reread_value", tokens: re_read)) %></dd>
  <% end -%>

  <dt><%= h(I18n.t("web.usage.facts.cache")) %></dt>
  <dd><%= h(cache) %></dd>

  <% unless saved.to_s.empty? -%>
    <dt><%= h(I18n.t("web.usage.facts.saved")) %></dt>
    <dd title="<%= h(I18n.t("web.usage.facts.saved_title")) %>">$<%= h(saved) %></dd>
  <% end -%>

  <% unless cache_history.to_s.empty? -%>
    <dt><%= h(I18n.t("web.usage.facts.cache_history")) %></dt>
    <dd title="<%= h(I18n.t("web.usage.facts.cache_history_title")) %>"><%= h(cache_history) %></dd>
  <% end -%>

  <dt><%= h(I18n.t("web.usage.facts.context")) %></dt>
  <dd><%= h(ctx) %></dd>
</dl>
