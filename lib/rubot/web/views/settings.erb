<%# The install's own settings, as a page in its own right.

    Not a card over the chat: there is no conversation behind this document, so
    there is nothing to float over. The document scrolls, the save button stays
    in a strip at the top, and the five subjects are tabs — one at a time, in a
    strip of mono labels — so the page never shows forty fields at once. Each
    panel opens with one faint line saying what it currently holds, which is
    what the tabs cannot say themselves.

    One form, five panels: the hidden panels are `display: none`, not disabled,
    so the single Save button still posts all of them. A reader who saves from
    the Instagram tab does not silently drop the model they changed earlier.

    Without a script the strip is hidden and every panel shows: a page that
    cannot switch tabs should read as the long page it used to be, not as four
    fifths of itself.

    The key is never sent back into the page — it is a password box with a
    sentence about what is already stored, because a form that echoes a
    credential is a credential in the page source, the browser's form history
    and every screenshot of it. -%>
<!DOCTYPE html>
<html lang="id" class="settings-doc">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%# The theme and the reading face, chosen before the first paint — the same
      partial the chat and the gate use, so this page cannot drift from them. -%>
  <%= View.render("_appearance_head") %>
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#2b332f">
  <title>rubot · pengaturan</title>
  <link rel="stylesheet" href="/assets/app.css?v=<%= h(asset_version) %>">
  <%# This page holds three controls that belong to the device — the palette,
      the typeface and the notification toggle — and all three are wired in
      app.js, so the page loads it. Nothing here is a chat, but the script is
      written to be absent-tolerant: every handler looks for its own markup
      first, and the worker it registers is what makes the toggle work at all. -%>
  <script src="/assets/app.js?v=<%= h(asset_version) %>"></script>
</head>
<body>
<div class="settings-topbar">
  <a class="settings-back" href="<%= h(back_url) %>"><span aria-hidden="true">←</span> kembali</a>
  <span class="settings-topbar-title">pengaturan</span>
  <% if saved %>
    <span class="settings-flash settings-saved" role="status">Tersimpan</span>
  <% end %>
  <button class="btn primary" type="submit" form="settings-form">Simpan</button>
</div>

<main class="settings-page">
  <%# `data-settings-tabs` marks the form as the tab root: the strip and the
      panels both live inside it, and the script reads one from the other. -%>
  <form id="settings-form" class="settings-form" method="post"
        action="/settings<%= h(token_query) %>" data-settings-tabs>
    <header class="settings-intro">
      <h1>Pengaturan</h1>
      <p class="settings-lead">
        Koneksi dan model berlaku untuk semua persona. Tema, font, dan notifikasi
        berlaku di perangkat ini, dan tersimpan begitu ditekan.
      </p>

      <% unless archived %>
        <p class="settings-error">
          Arsip sesi belum terbuka, jadi belum ada tempat untuk menyimpan.
        </p>
      <% end %>

      <%# A form that was refused comes back here with its reason: the value it
          named and what is accepted instead, written in the language the
          install still speaks. Nothing was stored, so nothing on the page is
          half-applied. -%>
      <% unless error.to_s.empty? %>
        <p class="settings-error" role="alert"><%= h(error) %></p>
      <% end %>
    </header>

    <div class="settings-tabs" role="tablist" aria-label="Bagian pengaturan">
      <% [["koneksi", "Koneksi"], ["tampilan", "Tampilan"], ["preset", "Preset model"],
          ["subagent", "Subagent"], ["instagram", "Instagram"]].each_with_index do |(name, label), index| -%>
        <button type="button" role="tab" class="settings-tab"
                id="settings-tab-<%= name %>" aria-controls="settings-panel-<%= name %>"
                aria-selected="<%= index.zero? ? "true" : "false" %>"
                tabindex="<%= index.zero? ? 0 : -1 %>"
                data-settings-tab="<%= name %>"><%= label %></button>
      <% end -%>
    </div>

    <section class="settings-panel is-active" role="tabpanel"
             id="settings-panel-koneksi" aria-labelledby="settings-tab-koneksi"
             data-settings-panel="koneksi">
      <p class="settings-tab-note"><%= h([provider.to_s, default_model.to_s].reject(&:empty?).join(" · ")) %></p>

      <div class="settings-field">
        <label for="setting-provider">Provider</label>
        <div class="settings-control">
          <select id="setting-provider" name="provider">
            <% provider_choices.each do |choice| %>
              <option value="<%= h(choice) %>"<%= " selected" if choice == provider %>><%= h(choice) %></option>
            <% end %>
          </select>
        </div>
      </div>

      <div class="settings-field">
        <label for="setting-api-key">API key</label>
        <div class="settings-control">
          <input id="setting-api-key" type="password" name="api_key" value=""
                 autocomplete="new-password" autocapitalize="off" autocorrect="off"
                 spellcheck="false"
                 placeholder="<%= key_set ? "sudah tersimpan, kosongkan untuk tidak mengubah" : "belum ada" %>">
          <% if key_from_archive %>
            <p class="settings-note">
              Tersimpan di database pemasangan. Centang untuk kembali ke config.yml.
            </p>
            <label class="settings-check">
              <input type="checkbox" name="clear_api_key" value="1">
              Hapus kunci dari database
            </label>
          <% elsif !key_set %>
            <p class="settings-note">
              Tanpa kunci, hanya provider lokal seperti ollama yang bisa menjawab.
            </p>
          <% end %>
        </div>
      </div>

      <div class="settings-field">
        <label for="setting-default-model">Model default</label>
        <div class="settings-control">
          <select id="setting-default-model" name="default_model">
            <%= model_option_tags(model_choices, default_model) %>
          </select>
        </div>
      </div>

      <div class="settings-field">
        <label for="setting-auxiliary-model">Model auxiliary</label>
        <div class="settings-control">
          <select id="setting-auxiliary-model" name="auxiliary_model">
            <%= model_option_tags(model_choices, auxiliary_model, blank: "Ikut model default") %>
          </select>
          <p class="settings-note">Untuk pekerjaan di belakang layar: merangkum dan menamai sesi.</p>
        </div>
      </div>

      <div class="settings-field">
        <label for="setting-subagent-model">Model subagent</label>
        <div class="settings-control">
          <select id="setting-subagent-model" name="subagent_model">
            <%= model_option_tags(model_choices, subagent_model, blank: "Ikuti preset subagent (flash)") %>
          </select>
          <p class="settings-note">Untuk semua subagent. Kosongkan untuk memakai preset bawaan.</p>
        </div>
      </div>

      <%# The one control that changes what every other row says. It sits with
          the install's settings because that is what it is — a language belongs
          to the installation, not to this browser — and it reads its own label
          and options through the dictionary, so the field is drawn in the
          language it has selected. -%>
      <div class="settings-field">
        <label for="setting-bahasa"><%= h(Rubot::I18n.t("settings.language.label")) %></label>
        <div class="settings-control">
          <select id="setting-bahasa" name="bahasa">
            <% Rubot::I18n::LOCALES.each do |code| -%>
              <option value="<%= h(code) %>"<%= " selected" if code == bahasa %>><%= h(Rubot::I18n.t("settings.language.#{code}")) %></option>
            <% end -%>
          </select>
          <p class="settings-note"><%= h(Rubot::I18n.t("settings.language.note")) %></p>
        </div>
      </div>
    </section>

    <%# The three choices that belong to this device rather than to the install:
       which palette, which reading face, and whether the device may be woken.
       None of them is a form field — the theme and the face are written to
       localStorage the moment they are pressed, and the push subscription is a
       browser object, not a column — which is why the panel says so once at the
       top instead of under each row. -%>
    <section class="settings-panel" role="tabpanel"
             id="settings-panel-tampilan" aria-labelledby="settings-tab-tampilan"
             data-settings-panel="tampilan">
      <p class="settings-tab-note">perangkat ini, tersimpan begitu ditekan</p>

      <div class="settings-field">
        <span class="settings-field-label">Tema</span>
        <div class="settings-control">
          <%= View.render("_theme_picker") %>
        </div>
      </div>

      <div class="settings-field">
        <span class="settings-field-label">Font</span>
        <div class="settings-control">
          <%# Each button is set in the face it offers: a name written in the
              font it names answers the question "what does this look like"
              without a preview pane beside it. -%>
          <div class="font-picker" role="group" aria-label="Font">
            <% font_choices.each do |choice| -%>
              <button type="button" class="font-choice" data-font-choice="<%= h(choice[:value]) %>"
                      aria-pressed="false" title="<%= h(choice[:title]) %>"><%= h(choice[:label]) %></button>
            <% end -%>
          </div>
          <p class="settings-note">
            Serif adalah bawaan. Georgia dan Palatino memakai huruf milik
            perangkat, jadi tampilannya bisa sedikit berbeda. Nama mesin tetap
            monospace.
          </p>
        </div>
      </div>

      <div class="settings-field">
        <span class="settings-field-label">Notifikasi</span>
        <div class="settings-control">
          <div class="push-picker" data-push-slug="<%= h(push_persona) %>">
            <button type="button" class="theme-swatch push-toggle" data-push-toggle
                    aria-pressed="false" title="Notifikasi saat app sedang ditutup">
              <span class="swatch-dot push-dot" aria-hidden="true"></span><span data-push-label>memuat…</span>
            </button>
            <button type="button" class="theme-swatch push-test" data-push-test hidden
                    title="Kirim satu notifikasi percobaan ke perangkat ini">
              kirim tes
            </button>
          </div>
          <p class="settings-note">
            Kabari perangkat ini saat app tertutup: pengingat, balasan yang
            selesai, atau subagent yang melapor. Izin diminta saat tombolnya
            ditekan.
          </p>
        </div>
      </div>
    </section>

    <section class="settings-panel" role="tabpanel"
             id="settings-panel-preset" aria-labelledby="settings-tab-preset"
             data-settings-panel="preset">
      <p class="settings-tab-note"><%= preset_rows.empty? ? "belum ada preset" : "#{preset_rows.size} preset" %></p>

      <% preset_rows.each do |row| %>
        <div class="settings-field settings-preset-row">
          <label for="preset-model-<%= h(row[:name]) %>"><%= h(row[:name]) %></label>
          <div class="settings-control">
            <input type="hidden" name="preset_name" value="<%= h(row[:name]) %>">
            <select id="preset-model-<%= h(row[:name]) %>" name="preset_model">
              <%= model_option_tags(model_choices, row[:model], blank: "Hapus preset ini") %>
            </select>
            <div class="settings-preset-fields">
              <label>Temperature
                <input type="text" name="preset_temperature" value="<%= h(row[:temperature]) %>" placeholder="bawaan">
              </label>
              <label>Max tokens
                <input type="text" name="preset_max_tokens" value="<%= h(row[:max_tokens]) %>" placeholder="bawaan">
              </label>
              <label>Reasoning
                <select name="preset_reasoning_effort">
                  <option value="">Bawaan</option>
                  <% Persona::THINKING_LEVELS.each do |level| %>
                    <option value="<%= h(level) %>"<%= " selected" if level == row[:reasoning_effort] %>><%= h(level) %></option>
                  <% end %>
                  <% unless row[:reasoning_effort].empty? || Persona::THINKING_LEVELS.include?(row[:reasoning_effort]) %>
                    <option value="<%= h(row[:reasoning_effort]) %>" selected><%= h(row[:reasoning_effort]) %></option>
                  <% end %>
                </select>
              </label>
            </div>
          </div>
        </div>
      <% end %>

      <%# Three blank rows, so several presets can be added in one save. -%>
      <% 3.times do |i| %>
        <div class="settings-field settings-preset-row">
          <label for="new-preset-name-<%= i %>">Preset baru</label>
          <div class="settings-control">
            <input id="new-preset-name-<%= i %>" type="text" name="new_preset_name" value=""
                   autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
                   placeholder="nama preset">
            <div class="settings-preset-fields">
              <label>Model
                <select name="new_preset_model">
                  <option value="">Pilih model</option>
                  <% model_choices.each do |choice| %>
                    <option value="<%= h(choice[:value]) %>"><%= h(choice[:label]) %></option>
                  <% end %>
                </select>
              </label>
              <label>Temperature
                <input type="text" name="new_preset_temperature" value="" placeholder="bawaan">
              </label>
              <label>Max tokens
                <input type="text" name="new_preset_max_tokens" value="" placeholder="bawaan">
              </label>
              <label>Reasoning
                <select name="new_preset_reasoning_effort">
                  <option value="">Bawaan</option>
                  <% Persona::THINKING_LEVELS.each do |level| %>
                    <option value="<%= h(level) %>"><%= h(level) %></option>
                  <% end %>
                </select>
              </label>
            </div>
          </div>
        </div>
      <% end %>
      <p class="settings-note">Isi nama dan pilih model pada baris yang ingin ditambahkan, lalu Simpan. Bisa beberapa sekaligus.</p>

      <div class="settings-field">
        <label for="setting-default-preset">Preset default</label>
        <div class="settings-control">
          <select id="setting-default-preset" name="default_preset">
            <option value="">Ikut config.yml</option>
            <% preset_rows.each do |row| %>
              <option value="<%= h(row[:name]) %>"<%= " selected" if row[:name] == default_preset %>><%= h(row[:name]) %></option>
            <% end %>
          </select>
          <p class="settings-note">Untuk sesi baru. Pilih "Ikut config.yml" untuk memakai nilai dari berkas.</p>
        </div>
      </div>
    </section>

    <section class="settings-panel" role="tabpanel"
             id="settings-panel-subagent" aria-labelledby="settings-tab-subagent"
             data-settings-panel="subagent">
      <p class="settings-tab-note"><%= subagent_rows.size.positive? ? "#{subagent_rows.size} persona" : "belum ada yang diatur" %></p>

      <% subagent_rows.each do |row| %>
        <div class="settings-field settings-preset-row">
          <label for="subagent-model-<%= h(row[:slug]) %>"><%= h(row[:name]) %></label>
          <div class="settings-control">
            <input type="hidden" name="subagent_slug" value="<%= h(row[:slug]) %>">
            <div class="settings-preset-fields">
              <label>Model
                <select id="subagent-model-<%= h(row[:slug]) %>" name="subagent_model_choice">
                  <%= model_option_tags(model_choices, row[:model], blank: "Bawaan") %>
                </select>
              </label>
              <label>Thinking
                <select name="subagent_thinking">
                  <option value="">Bawaan</option>
                  <% Persona::THINKING_LEVELS.each do |level| %>
                    <option value="<%= h(level) %>"<%= " selected" if level == row[:thinking] %>><%= h(level) %></option>
                  <% end %>
                </select>
              </label>
            </div>
          </div>
        </div>
      <% end %>
    </section>

    <section class="settings-panel" role="tabpanel"
             id="settings-panel-instagram" aria-labelledby="settings-tab-instagram"
             data-settings-panel="instagram">
      <p class="settings-tab-note"><%= ig_accounts.empty? ? "belum terhubung" : "#{ig_accounts.size} akun terhubung" %></p>

      <div class="settings-field">
        <label for="setting-ig-app-id">App ID</label>
        <div class="settings-control">
          <input id="setting-ig-app-id" type="text" name="instagram_app_id" value="<%= h(ig_app_id) %>"
                 autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
                 placeholder="dari Meta App">
        </div>
      </div>

      <div class="settings-field">
        <label for="setting-ig-secret">App Secret</label>
        <div class="settings-control">
          <input id="setting-ig-secret" type="password" name="instagram_app_secret" value=""
                 autocomplete="new-password" autocapitalize="off" autocorrect="off"
                 spellcheck="false"
                 placeholder="<%= ig_secret_set ? "sudah tersimpan, kosongkan untuk tidak mengubah" : "belum ada" %>">
          <% if ig_secret_set %>
            <label class="settings-check">
              <input type="checkbox" name="clear_ig_secret" value="1">
              Hapus App Secret dari database
            </label>
          <% end %>
        </div>
      </div>

      <div class="settings-field">
        <label for="setting-ig-redirect">Redirect URI</label>
        <div class="settings-control">
          <input id="setting-ig-redirect" type="url" name="instagram_redirect_uri" value="<%= h(ig_redirect_uri) %>"
                 autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
                 placeholder="https://nama.ts.net/instagram/callback">
          <p class="settings-note">
            Daftarkan di Meta App, Facebook Login, Valid OAuth Redirect URIs.
            Harus HTTPS (localhost boleh HTTP).
          </p>
        </div>
      </div>

      <div class="settings-field">
        <span class="settings-field-label">Akun terhubung</span>
        <div class="settings-control">
          <p class="settings-note">
            Persona <strong><%= h(ig_persona) %></strong>:
          </p>
          <% if ig_accounts.empty? %>
            <p class="settings-note">Belum ada. Ketik "connect ke instagram" di chat untuk mulai.</p>
          <% else %>
            <ul class="ig-account-list">
              <% ig_accounts.each do |acc| -%>
                <li class="ig-account-row">
                  <span class="ig-account-name">
                    <span class="ig-check" aria-hidden="true">✓</span>
                    @<%= h(acc["username"]) %><% if acc["is_default"] %> <span class="ig-default-label">(default)</span><% end %>
                  </span>
                </li>
              <% end -%>
            </ul>
            <label class="settings-check">
              <input type="checkbox" name="ig_disconnect" value="1">
              Putuskan semua akun Instagram persona ini
            </label>
          <% end %>
          <% unless ig_linkable_accounts.empty? -%>
            <p class="settings-note">Sudah terhubung di persona lain, centang untuk link ke persona ini tanpa OAuth:</p>
            <% ig_linkable_accounts.each do |acc| -%>
              <label class="settings-check">
                <input type="checkbox" name="ig_link" value="<%= h(acc["username"]) %>">
                @<%= h(acc["username"]) %>
              </label>
            <% end -%>
          <% end -%>
        </div>
      </div>
    </section>

    <footer class="settings-foot">
      <a href="/settings?refresh=1<%= h(token_query.empty? ? "" : "&" + token_query.sub(/^\?/, "")) %>">Refresh daftar model</a>
      <a href="<%= h(back_url) %>">Kembali ke percakapan</a>
    </footer>
  </form>
</main>
</body>
</html>
