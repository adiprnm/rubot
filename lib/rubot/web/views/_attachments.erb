<%# The files the agent sent during one turn, drawn as a strip rather than a
    column: a few screenshots are often wider than the column, and growing the
    answer downwards pushes the conversation out of view. The strip scrolls
    sideways, which keeps every file the same height and the thread the same
    width.

    A picture and a video are buttons, not links: opening one is a moment in
    the page, not a navigation — both fill the same lightbox, which shows a
    still image or a player depending on the kind. A document is a link,
    because there is nothing to show in the page — a PDF opens in the
    browser's own viewer, a markdown note opens as text — and it is the
    reader's own tab that should close it again. The download anchor beside
    them is a link, because that is what a download is: the same URL the
    lightbox or the tab offers, under the reader's own name.

    The strip is the row that changes when a file joins it, so the live turn
    addresses it by id and replaces it whole (see View#item_attrs). The cards
    inside carry their stored id and ask htmx to keep the node it already has:
    the file stays exactly as drawn instead of being fetched again. -%>
<div class="attachments"<%= defined?(attrs) ? attrs : "" %> role="group" aria-label="<%= h(I18n.t("web.attachments.group")) %>">
  <% attachments.each do |file| -%>
  <% if file[:kind] == :video -%>
  <figure class="attachment attachment--video"
          <% if file[:id] %>id="file-<%= h(file[:id]) %>" hx-preserve="true"<% end %>>
    <button type="button"
            class="attachment-open attachment-video-open"
            data-lightbox="<%= h(file[:url]) %>"
            data-lightbox-kind="video"
            data-name="<%= h(file[:name]) %>"
            aria-label="<%= h(I18n.t("web.attachments.play", name: file[:name])) %>">
      <video class="attachment-video"
             src="<%= h(file[:url]) %>"
             preload="metadata"
             muted
             playsinline
             aria-hidden="true"></video>
      <span class="attachment-play" aria-hidden="true">▶</span>
    </button>
    <a class="attachment-download"
       href="<%= h(file[:url]) %>"
       download="<%= h(file[:name]) %>"
       title="<%= h(I18n.t("web.attachments.download", name: file[:name])) %>"
       aria-label="<%= h(I18n.t("web.attachments.download", name: file[:name])) %>">↓</a>
  </figure>
  <% elsif file[:kind] == :document -%>
  <figure class="attachment attachment--document"
          <% if file[:id] %>id="file-<%= h(file[:id]) %>" hx-preserve="true"<% end %>>
    <a class="attachment-document"
       href="<%= h(file[:url]) %>"
       target="_blank"
       rel="noopener"
       title="<%= h(I18n.t("web.attachments.open", name: file[:name])) %>"
       aria-label="<%= h(I18n.t("web.attachments.open", name: file[:name])) %>">
      <% if File.extname(file[:name].to_s).casecmp?(".pdf") -%>
      <%= pdf_icon %>
      <% else -%>
      <span class="attachment-label" aria-hidden="true"><%= h(file[:label] || I18n.t("web.attachments.file")) %></span>
      <% end -%>
      <span class="attachment-name"><%= h(file[:name]) %></span>
    </a>
    <a class="attachment-download"
       href="<%= h(file[:url]) %>"
       download="<%= h(file[:name]) %>"
       title="<%= h(I18n.t("web.attachments.download", name: file[:name])) %>"
       aria-label="<%= h(I18n.t("web.attachments.download", name: file[:name])) %>">↓</a>
  </figure>
  <% else -%>
  <figure class="attachment"
          <% if file[:id] %>id="picture-<%= h(file[:id]) %>" hx-preserve="true"<% end %>>
    <button type="button"
            class="attachment-open"
            data-lightbox="<%= h(file[:url]) %>"
            data-name="<%= h(file[:name]) %>"
            aria-label="<%= h(I18n.t("web.attachments.open", name: file[:name])) %>">
      <img src="<%= h(file[:url]) %>" alt="<%= h(file[:name]) %>" loading="lazy">
    </button>
    <a class="attachment-download"
       href="<%= h(file[:url]) %>"
       download="<%= h(file[:name]) %>"
       title="<%= h(I18n.t("web.attachments.download", name: file[:name])) %>"
       aria-label="<%= h(I18n.t("web.attachments.download", name: file[:name])) %>">↓</a>
  </figure>
  <% end -%>
  <% end -%>
</div>
