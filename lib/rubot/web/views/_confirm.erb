<% if prompt -%>
<p class="confirm-title"><%= h(I18n.t("web.confirm.title", name: prompt[:name])) %></p>
<p class="confirm-reason"><%= h(prompt[:reason]) %></p>
<div class="confirm-actions">
  <button class="btn primary"
          hx-post="/turns/<%= h(turn_id) %>/confirm"
          hx-vals='{"value":"1"}'
          hx-swap="none"><%= h(I18n.t("web.confirm.continue")) %></button>
  <button class="btn"
          hx-post="/turns/<%= h(turn_id) %>/confirm"
          hx-vals='{"value":"0"}'
          hx-swap="none"><%= h(I18n.t("web.confirm.cancel")) %></button>
</div>
<% end -%>
