<%# What the manual compaction button did. One line: the reader pressed a
    button and wants to know whether it took. The seam itself is drawn in the
    thread after the page reloads, so it is not repeated here. -%>
<% case state -%>
<% when :busy -%>
  <p class="usage-note"><%= h(Rubot::I18n.t("compaction.busy")) %></p>
<% when :done -%>
  <p class="usage-note"><%= h(Rubot::I18n.t("compaction.note")) %></p>
<% when :error -%>
  <p class="usage-note"><%= h(Rubot::I18n.t("compaction.error")) %></p>
<% else -%>
  <p class="usage-note"><%= h(Rubot::I18n.t("compaction.empty")) %></p>
<% end -%>
