# Dependencies
Gemfile.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Workspace & runtime data
workspace/
*.jsonl
# Local notes and plans, not part of the shipped project. ADRs are the
# exception: they are the record of why the code is shaped the way it is, and
# only help someone who can read them. `docs/*` rather than `docs/`, because a
# negation cannot re-include a file under an ignored directory.
docs/*
!docs/adr/
# Specs, tickets and feature scratch work written by the pipeline skills.
.scratch/
# The TUI uses the directory it was launched from as its workspace, so these
# land in whatever project it runs in.
sessions/
cron/
model_catalog.json
model_pricing.json
MEMORY_ARCHIVE.md

# Ruby
*.gem
/pkg/

# Security reports
PEN_TEST_REPORT.md

# Docker local overrides & secrets
# The tracked base files are docker-compose.yml and
# docker-compose.override.yml.example. Your local override stays untracked.
docker-compose.override.yml
docker-compose.local.yml
.env
.env.local
.env.*
!.env.example
!.env.*.example
.rubot/
docker-data/
.bundle/
