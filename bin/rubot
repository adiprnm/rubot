#!/usr/bin/env ruby
# frozen_string_literal: true

# rubot - AI Assistant in Ruby
# Usage: rubot [options] [message]

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "rubot"
require "optparse"
require "fileutils"

# Handle subcommands
if ARGV.first == "init"
  ARGV.shift

  rubot_dir = File.expand_path("~/.rubot")
  config_dir = rubot_dir
  config_file = File.join(config_dir, "config.yml")
  workspace_dir = File.join(rubot_dir, "workspace")
  example_config = File.expand_path("../config/rubot.example.yml", __dir__)

  # Create config directory
  unless Dir.exist?(config_dir)
    FileUtils.mkdir_p(config_dir)
    puts "Created directory: #{config_dir}"
  else
    puts "Directory already exists: #{config_dir}"
  end

  # Copy example config if it doesn't exist
  if File.exist?(config_file)
    puts "Config file already exists: #{config_file}"
    puts "Edit it to set your API key: vim #{config_file}"
  else
    FileUtils.cp(example_config, config_file)
    puts "Created config: #{config_file}"
    puts "Edit it to set your API key: vim #{config_file}"
  end

  # Create workspace directory
  unless Dir.exist?(workspace_dir)
    FileUtils.mkdir_p(workspace_dir)
    puts "Created workspace: #{workspace_dir}"
  else
    puts "Workspace already exists: #{workspace_dir}"
  end

  # Create default SOUL.md
  soul_file = File.join(workspace_dir, "SOUL.md")
  unless File.exist?(soul_file)
    File.write(soul_file, Rubot::Soul::DEFAULT_SOUL)
    puts "Created soul file: #{soul_file}"
  else
    puts "Soul file already exists: #{soul_file}"
  end

  # Create default MEMORY.md
  memory_file = File.join(workspace_dir, "MEMORY.md")
  unless File.exist?(memory_file)
    File.write(memory_file, Rubot::Memory::DEFAULT_MEMORY)
    puts "Created memory file: #{memory_file}"
  else
    puts "Memory file already exists: #{memory_file}"
  end

  # Create default AGENTS.md
  agents_file = File.join(workspace_dir, "AGENTS.md")
  unless File.exist?(agents_file)
    File.write(agents_file, <<~AGENTS)
      ---
      # AGENTS.md frontmatter — override agent settings here
      # name: Rubot
      # model: gpt-4o-mini
      # max_tokens: 4096
      # temperature: 0.7
      # max_tool_iterations: 50
      # tools:
      #   exec: true
      #   file_ops: true
      #   web_fetch: true
      ---

      # Agent Rules

      - Be concise and direct in your responses.
      - Explain what you're doing before executing commands.
      - Use tools when they can help accomplish the task.
      - Remember important details by using the memory tool.
    AGENTS
    puts "Created agent rules: #{agents_file}"
  else
    puts "Agent rules already exist: #{agents_file}"
  end

  puts
  puts "Rubot initialized successfully."
  puts "Set your API key in #{config_file}, then run:"
  puts "  rubot"
  puts "Or use environment variables:"
  puts "  export RUBOT_API_KEY=\"sk-your-key-here\""
  puts "  rubot"
  exit
end

if ARGV.first == "check"
  ARGV.shift
  puts "╔══════════════════════════════════════════════╗"
  puts "║        🤖  Rubot Configuration Check  🤖   ║"
  puts "╚══════════════════════════════════════════════╝"
  puts

  ok = true
  issues = []

  # Parse -c/--config from remaining ARGV
  check_config_path = nil
  check_argv = ARGV.dup
  while check_argv.any?
    arg = check_argv.shift
    if arg == "-c" || arg == "--config"
      check_config_path = check_argv.shift
    elsif arg.start_with?("-c=")
      check_config_path = arg[3..]
    elsif arg.start_with?("--config=")
      check_config_path = arg[9..]
    end
  end

  # 1. Config file
  config = Rubot::Config.new(check_config_path)
  if File.exist?(config.config_path)
    puts "✅ Config file: #{config.config_path}"
  else
    puts "⚠️  Config file not found: #{config.config_path}"
    puts "   Run `rubot init` to create one."
    ok = false
  end

  # 2. API provider
  if config.api_key || %w[ollama].include?(config.provider)
    puts "✅ Provider: #{config.provider} (model: #{config.model})"
  else
    puts "❌ No API key found for provider: #{config.provider}"
    puts "   Set RUBOT_API_KEY or configure in #{config.config_path}"
    issues << :api_key
    ok = false
  end

  # 3. Workspace
  if Dir.exist?(config.workspace)
    puts "✅ Workspace: #{config.workspace}"
  else
    puts "⚠️  Workspace not found: #{config.workspace}"
    puts "   Run `rubot init` to create it."
  end

  # 4. Channels
  channels = config.data["channels"]
  if channels.nil? || channels.empty?
    puts "ℹ️  No channels configured — will use default REPL"
  elsif channels.is_a?(Hash)
    channels.each do |name, cfg|
      cfg ||= {}
      enabled = cfg["enabled"] != false
      status = enabled ? "enabled" : "disabled"
      icon = enabled ? "✅" : "⏸️"
      puts "#{icon} Channel: #{name} (#{status})"
      next unless enabled

      # Channel-specific checks
      if name == "telegram"
        token = cfg["token"] || ENV["TELEGRAM_BOT_TOKEN"]
        if token
          puts "   ✅ Bot token: configured"
          # Test the token against Telegram API
          begin
            require "net/http"
            require "json"
            require "uri"
            uri = URI("https://api.telegram.org/bot#{token}/getMe")
            resp = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.get(uri) }
            result = JSON.parse(resp.body)
            if result["ok"]
              bot = result["result"]
              puts "   ✅ Connected: @#{bot['username']} (id: #{bot['id']})"
            else
              puts "   ❌ Telegram API error: #{result['description']}"
              issues << :telegram_token
              ok = false
            end
          rescue StandardError => e
            puts "   ❌ Connection failed: #{e.message}"
            issues << :telegram_connection
            ok = false
          end
        else
          puts "   ❌ No bot token — set 'token' in config or TELEGRAM_BOT_TOKEN env var"
          issues << :telegram_token
          ok = false
        end
      end
    end
  end

  puts
  if ok
    puts "✅ All checks passed! Ready to run:"
    puts "   rubot"
    puts "   rubot -C telegram  # Telegram only"
    puts "   rubot -C repl      # REPL only"
  else
    puts "❌ Some checks failed. Fix the issues above before running."
    exit 1
  end

  exit
end

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: rubot [options] [message]"

  opts.on("-m", "--message MESSAGE", "Send a single message (non-interactive)") do |m|
    options[:message] = m
  end

  opts.on("-s", "--session SESSION", "Session ID (default: default)") do |s|
    options[:session] = s
  end

  opts.on("-p", "--provider PROVIDER", "Provider: openai, anthropic, ollama") do |p|
    options[:provider] = p
  end

  opts.on("-M", "--model MODEL", "Model name to use") do |m|
    options[:model] = m
  end

  opts.on("-c", "--config PATH", "Path to config file") do |c|
    options[:config] = c
  end

  opts.on("-d", "--debug", "Enable debug output") do
    options[:debug] = true
  end

  opts.on("-n", "--no-tools", "Disable tools") do
    options[:no_tools] = true
  end

  opts.on("--no-stream", "Disable streaming output") do
    options[:stream] = false
  end

  opts.on("-v", "--version", "Show version") do
    puts "rubot #{Rubot::VERSION}"
    exit
  end

  opts.on("-C", "--channel CHANNEL", "Channel to use: repl, telegram (default: repl)") do |c|
    options[:channel] = c
  end

  opts.on("-h", "--help", "Show this help") do
    puts opts
    puts
    puts "Subcommands:"
    puts "  init    Initialize config, workspace, and default files"
    puts "  check   Validate config and test channel connections"
    exit
  end
end

parser.parse!

# Build configuration
config = Rubot::Config.new(options[:config])

# Override with CLI options
config.data["debug"] = true if options[:debug]
config.data["tools"] = false if options[:no_tools]

if options[:provider]
  config.data["provider"] = options[:provider]
end

if options[:model]
  config.data["model"] = options[:model]
end

# Validate config
unless config.api_key || %w[ollama].include?(config.provider)
  $stderr.puts "Error: No API key found."
  $stderr.puts "Set RUBOT_API_KEY or configure in #{config.config_path}"
  $stderr.puts "For Ollama, set provider to 'ollama'."
  exit 1
end

# Build tools
tools = Rubot::Tools::Registry.new

# Build agent
agent = Rubot::Agent.new(
  config: config,
  session_id: options[:session] || "default",
  tools: tools
)

if options[:message]
  # Non-interactive mode — skip channel system
  puts agent.process(options[:message])
else
  # Channel mode — start configured channels
  Rubot::Channels::Registry.start_channels(
    data: config.data,
    agent: agent,
    options: options
  )
end
